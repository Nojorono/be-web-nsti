# Apache configuration for Node.js backend
# This file should be placed in the backend root directory

# Disable DirectoryIndex to prevent Apache from looking for index.php
DirectoryIndex disabled

# Enable proxy module and setup reverse proxy
<IfModule mod_proxy.c>
  ProxyPreserveHost On
  ProxyRequests Off
  
  # Proxy all requests to Node.js at 127.0.0.1:3000
  # Using ProxyPass is more reliable for reverse proxy
  ProxyPass / http://127.0.0.1:3000/
  ProxyPassReverse / http://127.0.0.1:3000/
</IfModule>

# Alternative: Use RewriteRule if ProxyPass doesn't work
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Don't proxy if file exists (for static files)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule . - [L]
  
  # Proxy all other requests to Node.js
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>

# Enable CORS headers (if needed)
# Header always set Access-Control-Allow-Origin "*"
# Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
# Header always set Access-Control-Allow-Headers "Content-Type, Authorization"

