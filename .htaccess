# Apache configuration for Node.js backend
# This file should be placed in the backend root directory

# Disable DirectoryIndex to prevent Apache from looking for index.php
DirectoryIndex disabled

# Disable auto-indexing
Options -Indexes

# Enable proxy module and setup reverse proxy
<IfModule mod_proxy.c>
  ProxyPreserveHost On
  ProxyRequests Off
  
  # Proxy ALL requests (including root /) to Node.js at 127.0.0.1:3000
  # Force proxy even for root path to prevent index.php lookup
  ProxyPass / http://127.0.0.1:3000/ nocanon
  ProxyPassReverse / http://127.0.0.1:3000/
  
  # Force proxy for root path explicitly
  ProxyPassMatch ^/$ http://127.0.0.1:3000/ nocanon
</IfModule>

# Fallback: Use RewriteRule if ProxyPass doesn't work
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Force proxy all requests including root / to Node.js
  # Don't check for files, proxy everything to avoid index.php lookup
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L,QSA]
</IfModule>

# Enable CORS headers (if needed)
# Header always set Access-Control-Allow-Origin "*"
# Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
# Header always set Access-Control-Allow-Headers "Content-Type, Authorization"

